# Data: raw, clean and processed files stay local; scripts, raw-data READMEs and the manifest are tracked
/data/*
!/data/scripts/
!/data/raw/
/data/raw/**
!/data/raw/*/
!/data/raw/*/README.md
!/data/raw/MANIFEST.sha256
.venv/
__pycache__/
.Rhistory
.DS_Store
*.Rproj.user
# LaTeX build files
reports/*.aux
reports/*.log
reports/*.out
reports/*.fls
reports/*.fdb_latexmk
reports/*.synctex.gz
reports/*.bbl
reports/*.blg

# Literature PDFs: copyrighted, not redistributed (index in papers/README.md)
papers/downloads/

# Rospatent API documentation (third-party, kept locally only)
/*.docx

# Local repo for private files (notes/, research-state.md, ANALYSIS_PLAN.md)
.git-private/

# Private research notes (versioned in the local repo .git-private, not public)
notes/

# Frozen outputs for regression checks (run_all.py --check)
archive/baseline/

# Local-only session state and analysis plan (versioned in .git-private)
research-state.md
ANALYSIS_PLAN.md

# Generated per-step logs
empirics/results/logs/
